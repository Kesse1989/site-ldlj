<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#0b3d91">
<title>LDLJ Digital International — Bureau numérique</title>
<link rel="manifest" href="manifest.webmanifest">
<style>
:root{--blue:#0b3d91;--blue2:#1769d1;--gold:#d6a928;--bg:#f4f7fb;--card:#fff;--text:#10213b;--muted:#64748b;--line:#e4eaf2;--ok:#16835b;--danger:#c23b3b}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif}
header{background:linear-gradient(135deg,var(--blue),#06275f);color:#fff;padding:18px 16px 22px;position:sticky;top:0;z-index:5}
.brand{display:flex;align-items:center;gap:12px} .logo{width:48px;height:48px;border-radius:14px;background:#fff;display:grid;place-items:center;color:var(--blue);font-weight:900;font-size:17px}.official-logo{padding:4px}.official-logo img{width:100%;height:100%;object-fit:contain;display:block;border-radius:10px}.brand b{font-size:17px}.brand small{display:block;opacity:.78;margin-top:2px}
main{max-width:1100px;margin:auto;padding:16px 16px 100px}.hero{margin-top:14px;padding:20px;border-radius:20px;background:linear-gradient(135deg,#fff,#eef5ff);border:1px solid var(--line)}
h1{font-size:26px;margin:0 0 8px}.hero p{color:var(--muted);margin:0 0 16px;line-height:1.5}
.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:14px 0}.card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:15px;box-shadow:0 4px 16px #183b6b0b}.stat b{display:block;font-size:24px}.muted{color:var(--muted);font-size:13px}
section{margin-top:18px}.section-title{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}.section-title h2{font-size:18px;margin:0}
.actions{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.btn{border:0;border-radius:13px;padding:13px 12px;font-weight:700;background:#eaf2ff;color:var(--blue);cursor:pointer}.btn.primary{background:var(--blue);color:white}.btn.gold{background:#fff5d8;color:#755900}.btn.danger{background:#fff0f0;color:var(--danger)}
.row{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:13px 0;border-bottom:1px solid var(--line)}.row:last-child{border-bottom:0}.badge{padding:5px 9px;border-radius:999px;background:#eaf7f1;color:var(--ok);font-size:12px;font-weight:700}.badge.pending{background:#fff5dc;color:#896500}.badge.info{background:#eaf2ff;color:var(--blue)}
.panel{background:#fff;border:1px solid var(--line);border-radius:16px;padding:15px}
input,select{width:100%;padding:12px;border:1px solid var(--line);border-radius:11px;background:#fff;font:inherit}.form{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.full{grid-column:1/-1}
.ai{display:flex;gap:8px}.ai input{flex:1}.ai button{min-width:90px}
nav{position:fixed;bottom:0;left:0;right:0;background:#fff;border-top:1px solid var(--line);display:flex;justify-content:center;z-index:10}nav .navin{max-width:650px;width:100%;display:grid;grid-template-columns:repeat(5,1fr)}nav button{border:0;background:none;padding:10px 4px;font-size:11px;color:var(--muted)}nav button b{display:block;font-size:18px;margin-bottom:2px;color:var(--blue)}
.toast{position:fixed;right:15px;bottom:75px;background:#10213b;color:#fff;padding:12px 14px;border-radius:12px;display:none;z-index:20}
@media(max-width:760px){.grid{grid-template-columns:repeat(2,1fr)}.actions{grid-template-columns:repeat(2,1fr)}.form{grid-template-columns:1fr}.hero h1{font-size:23px}}
</style>
</head>
<body>
<header>
 <div class="brand"><div class="logo official-logo"><img src="data:image/png;base64," alt="LDLJ — Leader de la Jeunesse"></div><div><b>LDLJ DIGITAL INTERNATIONAL</b><small>Bureau numérique mondial • Mobile first</small></div></div>
</header>
<main>
 <div class="hero">
   <h1>Bienvenue dans le bureau numérique LDLJ</h1>
   <p>Une plateforme unique pour gérer les membres, dossiers, candidatures, activités, documents et communications, depuis un téléphone.</p>
   <div class="ai"><input id="aiInput" placeholder="Demander à LDLJ AI…"><button class="btn primary" onclick="askAI()">IA</button></div>
 </div>

 <section>
  <div class="section-title"><h2>Vue d'ensemble</h2><span class="muted">Aujourd'hui</span></div>
  <div class="grid">
   <div class="card stat"><span class="muted">Membres</span><b>5 248</b><span class="badge">Actifs</span></div>
   <div class="card stat"><span class="muted">Dossiers</span><b>126</b><span class="badge pending">À traiter</span></div>
   <div class="card stat"><span class="muted">Candidatures</span><b>42</b><span class="badge info">En cours</span></div>
   <div class="card stat"><span class="muted">Activités</span><b>18</b><span class="badge">Planifiées</span></div>
  </div>
 </section>

 <section>
  <div class="section-title"><h2>Actions rapides</h2></div>
  <div class="actions">
   <button class="btn primary" onclick="openMember()">＋ Nouveau membre</button>
   <button class="btn" onclick="toast('Module Dossiers ouvert')">📂 Dossiers</button>
   <button class="btn" onclick="toast('Module Candidatures ouvert')">📝 Candidatures</button>
   <button class="btn" onclick="toast('Nouvelle activité')">📅 Activité</button>
   <button class="btn gold" onclick="toast('Générateur de quittance prêt')">🧾 Quittance</button>
   <button class="btn" onclick="toast('SMS PRO : module prêt pour connexion fournisseur')">📩 SMS PRO</button>
  </div>
 </section>

 <section id="memberPanel" style="display:none">
  <div class="section-title"><h2>Créer un membre</h2></div>
  <div class="panel">
   <div class="form">
    <div><label class="muted">Nom complet</label><input id="mName" placeholder="Nom et prénom"></div>
    <div><label class="muted">Téléphone</label><input id="mPhone" placeholder="+225…"></div>
    <div><label class="muted">Pays</label><select id="mCountry"><option>Côte d’Ivoire</option><option>Ghana</option><option>France</option><option>Canada</option><option>Autre pays</option></select></div>
    <div><label class="muted">Langue</label><select><option>Français</option><option>English</option><option>Dioula</option><option>Baoulé</option></select></div>
    <div class="full"><button class="btn primary" onclick="createMember()">Créer l'identité LDLJ</button> <button class="btn" onclick="closeMember()">Annuler</button></div>
   </div>
  </div>
 </section>

 <section>
  <div class="section-title"><h2>À traiter</h2><span class="muted">Priorités</span></div>
  <div class="panel">
   <div class="row"><div><b>Candidature LDLJ-CI-2026-0042</b><div class="muted">Nouvelle candidature</div></div><span class="badge pending">Urgent</span></div>
   <div class="row"><div><b>Dossier LDLJ-CI-2026-00126</b><div class="muted">Pièce complémentaire attendue</div></div><span class="badge pending">À vérifier</span></div>
   <div class="row"><div><b>Activité nationale</b><div class="muted">Validation du programme</div></div><span class="badge info">En attente</span></div>
  </div>
 </section>

 <section>
  <div class="section-title"><h2>LDLJ MONDE</h2></div>
  <div class="grid">
   <div class="card"><b>🌍 Pays</b><p class="muted">Structures nationales configurables</p></div>
   <div class="card"><b>🌐 Langues</b><p class="muted">Interface multilingue par clés de traduction</p></div>
   <div class="card"><b>💳 Devises</b><p class="muted">Monnaies et paiements par pays</p></div>
   <div class="card"><b>🕐 Fuseaux</b><p class="muted">Dates et notifications adaptées</p></div>
  </div>
 </section>

 <section>
  <div class="section-title"><h2>Écosystème</h2></div>
  <div class="grid">
   <div class="card"><b>🪪 Identité LDLJ</b><p class="muted">Carte numérique + QR + vérification</p></div>
   <div class="card"><b>🎓 LDLJ Academy</b><p class="muted">Formations et parcours</p></div>
   <div class="card"><b>💡 LDLJ Lab</b><p class="muted">Projets et innovation</p></div>
   <div class="card"><b>🚀 Opportunités</b><p class="muted">Emplois, missions et programmes</p></div>
  </div>
 </section>
</main>

<nav><div class="navin">
 <button onclick="topPage()"><b>⌂</b>Accueil</button>
 <button onclick="toast('Espace Mon LDLJ')"><b>◉</b>Mon LDLJ</button>
 <button onclick="openMember()"><b>＋</b>Adhérer</button>
 <button onclick="toast('Notifications')"><b>♢</b>Alertes</button>
 <button onclick="toast('Menu international')"><b>☰</b>Menu</button>
</div></nav>
<div class="toast" id="toast"></div>
<script>
function toast(t){const e=document.getElementById('toast');e.textContent=t;e.style.display='block';clearTimeout(window.tt);window.tt=setTimeout(()=>e.style.display='none',2200)}
function openMember(){document.getElementById('memberPanel').style.display='block';document.getElementById('memberPanel').scrollIntoView({behavior:'smooth'})}
function closeMember(){document.getElementById('memberPanel').style.display='none'}
function createMember(){
 const n=document.getElementById('mName').value.trim(); const p=document.getElementById('mPhone').value.trim();
 if(!n||!p){toast('Nom et téléphone requis');return}
 const id='LDLJ-CI-'+new Date().getFullYear()+'-'+String(Date.now()).slice(-6);
 localStorage.setItem('ldlj_last_member',JSON.stringify({id,name:n,phone:p,country:document.getElementById('mCountry').value}));
 toast('Identité créée : '+id); closeMember();
}
function askAI(){const q=document.getElementById('aiInput').value.trim();if(!q){toast('Écrivez votre demande');return}toast('LDLJ AI : réponse simulée — le moteur IA sera connecté au backend sécurisé.')}
function topPage(){window.scrollTo({top:0,behavior:'smooth'})}
if('serviceWorker' in navigator){navigator.serviceWorker.register('sw.js').catch(()=>{})}
</script>
</body>
</html>
